# Root-level environment variables (docker compose 용)
# Copy this file to .env and fill values.

# COMPOSE_PROJECT_NAME=my-app

# ── Caddy (프로덕션 프록시) ─────────────────────────────
# 도메인이 있으면 넣는다 → HTTPS 인증서 자동 발급/갱신 (80/443 열려 있어야 함)
# SITE_ADDRESS=example.com
# 도메인 없이 IP만 쓰면 비워둔다 (기본 :80 HTTP)

# SvelteKit CSRF 검사용 공개 origin (도메인 쓰면 https://example.com)
# PUBLIC_ORIGIN=http://localhost

# ── Ports (host) ───────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# dev override 용
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ── Database (필요 시) ─────────────────────────────────
# POSTGRES_USER=app
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=app
